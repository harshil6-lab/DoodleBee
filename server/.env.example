# DoodleBee Stage 03 backend environment.
# Copy to `server/.env` and fill in local values. NEVER commit real values.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL is the permanent system of record (D03-006).
DATABASE_URL=postgres://doodlebee:doodlebee@127.0.0.1:5433/doodlebee

# Redis holds the authoritative transient live state (D03-006).
REDIS_URL=redis://127.0.0.1:6379

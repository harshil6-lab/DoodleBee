{
  "name": "@doodlebee/server",
  "version": "1.0.0",
  "private": true,
  "description": "DoodleBee Stage 03 backend: Fastify v5 + Socket.IO 4.8.4, server-authoritative.",
  "type": "module",
  "main": "dist/server/src/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/seedWords.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.0.0",
    "globals": "17.12.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}

# DoodleBee client environment configuration.
# Copy this file to .env.local and fill in local values.
# NEVER commit real values, tokens, or secrets.
#
# EXPO_PUBLIC_* variables are embedded into the client bundle at build time.
# Only non-sensitive values belong here.

# Base URL for REST endpoints (ADR section 10)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Base URL for the Socket.IO server (ADR section 11)
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000